{
    "version": 8,
    "configurePresets": [
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "description": "Desktop Linux with ASAN+UBSAN",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "description": "Desktop Linux optimised build",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "android-arm64",
            "displayName": "Android ARM64",
            "description": "Android NDK cross-compile for arm64-v8a",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/android-arm64",
            "toolchainFile": "$env{ANDROID_HOME}/ndk/29.0.14206865/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ANDROID_PLATFORM": "android-24",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_STL": "c++_static"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "jobs": 8
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "jobs": 8
        },
        {
            "name": "android-arm64",
            "configurePreset": "android-arm64",
            "jobs": 8
        }
    ]
}
